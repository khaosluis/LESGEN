Cell[BoxData[
 RowBox[{
  RowBox[{"LESGEN", "[", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"nEjercicios", ",", "homeworkLinearEqGen"}], "}"}], ",", 
    RowBox[{
     RowBox[{"nEjercicios", "=", 
      RowBox[{"RandomInteger", "[", 
       RowBox[{"{", 
        RowBox[{"2", ",", "4"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"homeworkLinearEqGen", "=", 
      RowBox[{"Rasterize", "[", 
       RowBox[{
        RowBox[{"Column", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Style", "[", 
            
            RowBox[{"\"\<Resuelve los siguientes sistemas de ecuaciones \
lineales:\>\"", ",", "13", ",", "StandardPurple", ",", "Bold"}], "]"}], ",", 
           RowBox[{"TableForm", "[", 
            RowBox[{"{", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"Module", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"eqGen", ",", "eqSol"}], "}"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"eqGen", "=", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"RandomInteger", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "5"}], ",", "5"}], "}"}], "]"}], " ", "x"}], 
                    "+", 
                    RowBox[{
                    RowBox[{"RandomInteger", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "5"}], ",", "5"}], "}"}], "]"}], " ", "y"}], 
                    "+", 
                    RowBox[{
                    RowBox[{"RandomInteger", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "5"}], ",", "5"}], "}"}], "]"}], " ", 
                    "z"}]}], "==", 
                    RowBox[{"RandomInteger", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "10"}], ",", "10"}], "}"}], "]"}]}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"RandomInteger", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "5"}], ",", "5"}], "}"}], "]"}], " ", "x"}], 
                    "+", 
                    RowBox[{
                    RowBox[{"RandomInteger", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "5"}], ",", "5"}], "}"}], "]"}], " ", "y"}], 
                    "+", 
                    RowBox[{
                    RowBox[{"RandomInteger", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "5"}], ",", "5"}], "}"}], "]"}], " ", 
                    "z"}]}], "==", 
                    RowBox[{"RandomInteger", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "10"}], ",", "10"}], "}"}], "]"}]}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"RandomInteger", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "5"}], ",", "5"}], "}"}], "]"}], " ", "x"}], 
                    "+", 
                    RowBox[{
                    RowBox[{"RandomInteger", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "5"}], ",", "5"}], "}"}], "]"}], " ", "y"}], 
                    "+", 
                    RowBox[{
                    RowBox[{"RandomInteger", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "5"}], ",", "5"}], "}"}], "]"}], " ", 
                    "z"}]}], "==", 
                    RowBox[{"RandomInteger", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "10"}], ",", "10"}], "}"}], "]"}]}]}], 
                    "}"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"eqSol", "=", 
                    RowBox[{"Solve", "[", 
                    RowBox[{"eqGen", ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"TableForm", "[", 
                    RowBox[{"Column", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Row", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    
                    RowBox[{"\"\<\[CenterDot]\>\"", ",", "Bold", ",", "24", ",",
                     "Red"}], "]"}], ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"eqGen", ",", "10"}], "]"}]}], "}"}], "]"}], ",", 
                    RowBox[{"Row", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    
                    RowBox[{"\"\<SOLUCI\[CapitalOAcute]N: \>\"", ",", "8", ",",
                     "Italic", ",", "Blue", ",", "Bold"}], "]"}], ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"eqSol", ",", "8", ",", "Italic"}], "]"}]}], 
                    "}"}], "]"}]}], "}"}], "]"}], "]"}]}]}], "]"}], ",", 
                 RowBox[{"{", "nEjercicios", "}"}]}], "]"}], ",", 
               "nEjercicios"}], "]"}], "}"}], "]"}]}], "}"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"ImageResolution", "->", "300"}], ",", " ", 
        RowBox[{"ImageSize", "->", "Full"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "homeworkLinearEqGen"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.99771182600622*^9, 3.99771182600622*^9}, {
   3.997714536609644*^9, 3.9977145521420765`*^9}, 3.9977197365740128`*^9, {
